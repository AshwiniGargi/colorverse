# PostgreSQL / Prisma
# Pooled runtime connection for the deployed application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Direct, non-pooled connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Clerk: create these in the Clerk Dashboard. Configure Google as the sole
# sign-in provider there; do not add Google OAuth client secrets to this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
# Comma-separated, lower-case staff email addresses permitted to enter /admin.
ADMIN_EMAIL_ALLOWLIST="admin@example.com"

# Cloudinary: server-only credentials for signed staff uploads and asset management.
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

# Public canonical site origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional local escape hatch for tooling only. Never enable in preview or production.
SKIP_ENV_VALIDATION="false"
